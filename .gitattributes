# This repository is authored on Windows and built on Android, Linux and
# macOS. Normalise line endings in the repository so a Graviton or NDK
# build never sees CRLF in a shell script.
* text=auto eol=lf

*.ps1  text eol=crlf

*.png  binary
*.jpg  binary
*.so   binary
*.wasm binary

# Device captures are evidence. Never let a merge tool rewrite them.
results/*.txt -merge
results/*.json -merge
